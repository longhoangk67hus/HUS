# Cinema System - Environment Variables Template
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=cinema_system

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=jvz38n2ZTSEsdXUGYVf5FkPpHBKe9yr6, 
JWT_EXPIRES_IN=1d

# Session Configuration
SESSION_SECRET=your_session_secret_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Reservation Configuration
RESERVATION_TIMEOUT_MINUTES=15

# Bull Queue Configuration
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379

# Email Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ngoclong7204@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=Cinema System
SMTP_ENABLE_SSL=true
SEND_EMAIL_AFTER_REGISTER=true

# VNPay Payment Gateway (Sandbox)
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your_vnpay_terminal_id
VNPAY_HASH_SECRET=your_vnpay_secret_key

# VNPay Callback URLs (Update with your ngrok/domain)
VNPAY_IPN_URL=https://your-ngrok-url.ngrok-free.dev/api/payments/vnpay/callback
VNPAY_RETURN_URL=https://your-ngrok-url.ngrok-free.dev/api/payments/vnpay/return